    { "id": "metadata_case_insensitive_authors", "valid": true, "markdown": "---\nTitle: \"Statistical Mechanics\"\nAuthor:\n  - Literal: Ludwig Boltzmann\n  - Given: Josiah\n    Family: Gibbs\n  - Name:\n      Given: Emmy\n      Family: Noether\n  - Name:\n      Literal: Paul Dirac\nCreator: Josiah Gibbs\nAbstract: |-\n  Canonical ensemble\n  derivations.\nKeywords: [entropy, ensembles]\nTags: [physics, entropy]\n...\n# Body", "body": "# Body", "entries": { "Title": "Statistical Mechanics", "Author": [{ "Literal": "Ludwig Boltzmann" }, { "Given": "Josiah", "Family": "Gibbs" }, { "Name": { "Given": "Emmy", "Family": "Noether" } }, { "Name": { "Literal": "Paul Dirac" } }], "Creator": "Josiah Gibbs", "Abstract": "Canonical ensemble\nderivations.", "Keywords": ["entropy", "ensembles"], "Tags": ["physics", "entropy"] }, "metadata": { "title": "Statistical Mechanics", "authors": ["Ludwig Boltzmann", "Josiah Gibbs", "Emmy Noether", "Paul Dirac"], "description": "Canonical ensemble\nderivations.", "keywords": ["entropy", "ensembles", "physics"], "tags": ["physics", "entropy", "ensembles"] } },
