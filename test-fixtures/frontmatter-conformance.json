    { "id": "flow_maps_and_compact_colons", "valid": true, "markdown": "---\nmeta: {env: prod, \"port:http\": 8080, flags: [true, false, ~], 'nested': {ok: yes}, trailing: [1, 2,],}\nmultiline: {\n  a:1,\n  \"b\":2, # flow comment\n  'c':3\n}\n---\nBody", "body": "Body", "entries": { "meta": { "env": "prod", "port:http": "8080", "flags": [true, false, null], "nested": { "ok": "yes" }, "trailing": ["1", "2"] }, "multiline": { "a": "1", "b": "2", "c": "3" } }, "metadata": null },
